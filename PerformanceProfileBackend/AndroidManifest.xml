<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.performanceprofilebackend"
    android:sharedUserId="android.uid.system">

    <application>
        <!-- The core system permission-locked receiver backend gateway -->
        <receiver 
            android:name=".ProfileCommandReceiver"
            android:exported="true" />

        <!-- QUICK SETTINGS TILE SERVICE (Moved here to preserve persist.sys execution) -->
        <service
            android:name=".PerformanceProfileTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_manage"
            android:label="Performance"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
