android_app {
    name: "PerformanceProfile",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform", // Keep it platform-signed for matching signature security checks
    privileged: false,       // Moved out of priv-app space
    optimize: {
        enabled: false,
    },
}
