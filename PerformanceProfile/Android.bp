android_app {
    name: "PerformanceProfile",
    manifest: "AndroidManifest.xml",

    srcs: [
        "src/**/*.java",
    ],

    resource_dirs: [
        "res",
    ],

    static_libs: [
        "androidx.preference_preference",
        "androidx.fragment_fragment",
    ],

    platform_apis: true,
    certificate: "platform",
    privileged: true,

    optimize: {
        enabled: false,
    },
}
