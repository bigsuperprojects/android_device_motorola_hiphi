<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_performance_profile"
        android:label="@string/app_name"
        android:theme="@style/Theme.PerformanceProfile">

        <!-- Real activity. Keep it enabled: the QS tile launches it explicitly. -->
        <activity
            android:name=".PerformanceProfileActivity"
            android:exported="true"
            android:label="@string/performance_profile_title" />

        <!-- Only this alias has a launcher entry. The tile hides/restores it. -->
        <activity-alias
            android:name=".PerformanceProfileLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_performance_profile"
            android:label="@string/app_name"
            android:targetActivity=".PerformanceProfileActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <service
            android:name=".PerformanceProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_performance_profile"
            android:label="@string/performance_profile_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

        </service>

    </application>

</manifest>
