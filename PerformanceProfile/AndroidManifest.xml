<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="org.lineageos.performanceprofile">
    
        <application
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="Performance profile"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
    
            <!-- MAIN CONFIG ACTIVITY -->
            <!-- Fixed: Added the mandatory LAUNCHER category, but removed the MAIN action -->
            <activity
                android:name="org.lineageos.performanceprofile.PerformanceProfileActivity"
                android:exported="true"
                android:label="Performance profile">
                <intent-filter>
                    <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>
    
            <!-- 0: Low Performance Mode Alias -->
            <activity-alias
                android:name="org.lineageos.performanceprofile.LauncherLow"
                android:enabled="false"
                android:icon="@mipmap/ic_launcher_low"
                android:label="Performance profile"
                android:targetActivity="org.lineageos.performanceprofile.PerformanceProfileActivity"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity-alias>
    
            <!-- 1: Medium/Default Mode Alias (Enabled by default) -->
            <activity-alias
                android:name="org.lineageos.performanceprofile.LauncherMedium"
                android:enabled="true"
                android:icon="@mipmap/ic_launcher"
                android:label="Performance profile"
                android:targetActivity="org.lineageos.performanceprofile.PerformanceProfileActivity"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity-alias>
    
            <!-- 2: High Performance Mode Alias -->
            <activity-alias
                android:name="org.lineageos.performanceprofile.LauncherHigh"
                android:enabled="false"
                android:icon="@mipmap/ic_launcher_high"
                android:label="Performance profile"
                android:targetActivity="org.lineageos.performanceprofile.PerformanceProfileActivity"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity-alias>
    
            <!-- BACKWARD SYNC GATEWAY INTERCEPTOR -->
            <receiver
                android:name="org.lineageos.performanceprofile.TileSyncReceiver"
                android:exported="true">
                <intent-filter>
                    <action android:name="org.lineageos.performanceprofile.ACTION_SYNC_ICON" />
                </intent-filter>
            </receiver>
    
        </application>
    </manifest>
